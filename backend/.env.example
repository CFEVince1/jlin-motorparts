PORT=5000
NODE_ENV=production
JWT_SECRET=jlin_jwt_secret_production_key_change_me
FRONTEND_URL=https://your-project.vercel.app

# Optional: Initial credentials if initializing an empty database (minimum 8 characters)
# INITIAL_ADMIN_PASSWORD=your_secure_admin_password_here
# INITIAL_STAFF_PASSWORD=your_secure_staff_password_here

# ==========================================
# AIVEN CLOUD MYSQL CONFIGURATION
# ==========================================
# Option A: Complete Connection URI (Recommended for Render)
# DATABASE_URL=mysql://avnadmin:YOUR_PASSWORD@mysql-xxxx.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED

# Option B: Separate Environment Variables
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=jlin_inventory_db
DB_SSL=false

# Email / SMTP Configuration (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
