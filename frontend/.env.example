# ==========================================
# FRONTEND VERCEL ENVIRONMENT CONFIGURATION
# ==========================================

# 1. URL to your Render backend API (include /api suffix)
# Example: https://jlin-inventory-api.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# 2. Force Demo / Mock Mode (true / false)
# When true, the app uses in-browser realistic mock data with zero backend dependencies!
VITE_USE_MOCK=false
